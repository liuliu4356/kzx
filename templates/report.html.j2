<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>巡检报告 — {{ generated_at }}</title>
<style>
:root{--red:#dc2626;--red-bg:#fef2f2;--green:#16a34a;--green-bg:#f0fdf4;
      --amber:#d97706;--amber-bg:#fffbeb;--blue:#2563eb;--blue-bg:#eff6ff;
      --gray:#6b7280;--border:#e5e7eb;--radius:8px;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
     color:#111827;background:#f9fafb;padding:1.5rem;}
.container{max-width:1100px;margin:0 auto;}
h1{font-size:1.5rem;font-weight:700;margin-bottom:.25rem;}
.meta{color:var(--gray);font-size:.875rem;margin-bottom:1.5rem;}
.section{background:#fff;border:1px solid var(--border);border-radius:var(--radius);
         padding:1.25rem;margin-bottom:1rem;box-shadow:0 1px 3px rgba(0,0,0,.05);}
.section-title{font-size:1rem;font-weight:700;margin-bottom:.875rem;
               padding-bottom:.5rem;border-bottom:2px solid var(--border);}
.site-title{font-size:1.125rem;font-weight:700;margin:.5rem 0 1rem;
            padding:.5rem .875rem;background:var(--blue-bg);border-left:4px solid var(--blue);
            border-radius:0 var(--radius) var(--radius) 0;}
/* Summary table */
.summary-table{width:100%;border-collapse:collapse;font-size:.875rem;}
.summary-table th{background:#f3f4f6;padding:.55rem .75rem;text-align:left;font-size:.8125rem;color:var(--gray);}
.summary-table td{padding:.55rem .75rem;border-bottom:1px solid var(--border);}
.summary-table tr:last-child td{border-bottom:none;}
/* Badges */
.badge{display:inline-block;padding:.2rem .5rem;border-radius:999px;font-size:.75rem;font-weight:500;}
.badge-ok  {background:var(--green-bg);color:var(--green);}
.badge-warn{background:var(--amber-bg);color:var(--amber);}
.badge-err {background:var(--red-bg);  color:var(--red);}
.badge-gray{background:#f3f4f6;color:var(--gray);}
/* Metric sections */
.metric-block{margin-bottom:1.25rem;padding:.875rem;border:1px solid var(--border);
              border-radius:var(--radius);}
.metric-block.anomaly{border-color:var(--red);background:var(--red-bg);}
.metric-name{font-weight:700;font-size:.9375rem;margin-bottom:.4rem;}
.metric-stats{font-size:.8125rem;color:#374151;margin-bottom:.5rem;}
.metric-stats span{margin-right:1.25rem;}
/* Anomaly window table */
.win-table{width:100%;border-collapse:collapse;font-size:.8125rem;margin-top:.5rem;}
.win-table th{background:rgba(220,38,38,.08);padding:.4rem .6rem;text-align:left;color:var(--red);}
.win-table td{padding:.4rem .6rem;border-bottom:1px solid rgba(220,38,38,.15);}
.win-table tr:last-child td{border-bottom:none;}
.win-ip{font-family:monospace;font-size:.8125rem;}
.win-badge{background:var(--red);color:#fff;border-radius:4px;padding:.15rem .4rem;font-size:.75rem;}
/* FAQ */
.faq{background:#fffbeb;border:1px solid #fde68a;border-radius:var(--radius);
     padding:.75rem;margin-top:.6rem;font-size:.8125rem;}
.faq-title{font-weight:600;color:var(--amber);margin-bottom:.3rem;}
/* ES section */
.es-block{margin-bottom:1rem;padding:.875rem;border:1px solid var(--border);border-radius:var(--radius);}
.es-block.ignorable{opacity:.7;}
.log-list{font-family:monospace;font-size:.75rem;background:#1e293b;color:#94a3b8;
          padding:.75rem;border-radius:6px;max-height:200px;overflow-y:auto;margin-top:.5rem;}
/* AI section */
.ai-content{font-size:.875rem;line-height:1.7;white-space:pre-wrap;}
/* Print */
@media print{body{background:#fff;padding:0;}
  .section{break-inside:avoid;box-shadow:none;}}
</style>
</head>
<body>
<div class="container">
<h1>🔍 巡检报告</h1>
<div class="meta">
  {{ generated_at }} &nbsp;·&nbsp;
  模式：{{ "时间段审计" if mode == "range" else "快照" }}
  {% if period_str %} · {{ period_str }}{% endif %} &nbsp;·&nbsp;
  模型：{{ model }} &nbsp;·&nbsp;
  总异常：<strong style="color:{% if total_anomaly_count %}var(--red){% else %}var(--green){% endif %}">{{ total_anomaly_count }}</strong>
</div>

<!-- 汇总 -->
<div class="section">
<div class="section-title">各机房汇总</div>
<table class="summary-table">
<thead><tr><th>机房</th><th>异常指标</th><th>{% if mode=='range' %}异常窗口{% else %}总指标{% endif %}</th><th>状态</th></tr></thead>
<tbody>
{% for s in site_results %}
<tr>
  <td><strong>{{ s.label }}</strong></td>
  <td>{{ s.anomaly_count }}</td>
  <td>{% if mode=='range' %}{{ s.total_anomaly_windows }} 段{% else %}{{ s.prom_results|length }}{% endif %}</td>
  <td>{% if s.anomaly_count %}<span class="badge badge-err">⚠️ 有异常</span>{% else %}<span class="badge badge-ok">✅ 正常</span>{% endif %}</td>
</tr>
{% endfor %}
</tbody>
</table>
</div>

<!-- 各机房详情 -->
{% for s in site_results %}
<div class="section">
<div class="site-title">🏢 {{ s.label }}</div>

{% if mode == 'range' %}
{# ═══ 时间段审计 ═══ #}
<div class="section-title">Prometheus 指标</div>
{% for r in s.prom_range_results %}
<div class="metric-block {% if r.is_anomaly %}anomaly{% endif %}">
  <div class="metric-name">
    {% if r.is_anomaly %}🔴{% else %}✅{% endif %} {{ r.name }}
    {% if r.error %}<span class="badge badge-gray">采集错误</span>{% endif %}
  </div>
  {% if r.error %}
  <div style="color:var(--red);font-size:.875rem">⚠️ {{ r.error }}</div>
  {% else %}
  <div class="metric-stats">
    <span>最高 <strong>{{ "%.3f"|format(r.period_max) }}{{ r.unit }}</strong></span>
    <span>平均 {{ "%.3f"|format(r.period_avg) }}{{ r.unit }}</span>
    <span>最低 {{ "%.3f"|format(r.period_min) }}{{ r.unit }}</span>
    <span>阈值 <strong>{{ r.threshold }}{{ r.unit }}</strong></span>
  </div>
  {% if r.anomaly_windows %}
  <table class="win-table">
    <thead><tr><th>🔴 时间段</th><th>节点 IP</th><th>峰值</th><th>阈值</th><th>持续时长</th></tr></thead>
    <tbody>
    {% for w in r.anomaly_windows %}
    <tr>
      <td><span class="win-badge">异常</span> {{ w.start_ts }} ~ {{ w.end_ts }}</td>
      <td class="win-ip">{{ w.instance }}</td>
      <td style="color:var(--red);font-weight:700">{{ "%.3f"|format(w.max_value) }}{{ w.unit }}</td>
      <td>{{ w.threshold }}{{ w.unit }}</td>
      <td>{{ w.duration_minutes }} 分钟</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endif %}
  {# FAQ #}
  {% if r.is_anomaly and r.faq %}
  <div class="faq"><div class="faq-title">💡 处理建议</div><pre style="white-space:pre-wrap;font-family:inherit">{{ r.faq }}</pre></div>
  {% endif %}
</div>
{% endfor %}

{% else %}
{# ═══ 快照模式 ═══ #}
<div class="section-title">Prometheus 指标</div>
<table class="summary-table">
<thead><tr><th>指标</th><th>当前值</th><th>阈值</th><th>状态</th><th>错误</th></tr></thead>
<tbody>
{% for r in s.prom_results %}
<tr {% if r.is_anomaly %}style="background:var(--red-bg)"{% endif %}>
  <td><strong>{{ r.name }}</strong></td>
  <td {% if r.is_anomaly %}style="color:var(--red);font-weight:700"{% endif %}>
    {{ "%.3f"|format(r.value) ~ r.unit if r.value is not none else "—" }}
  </td>
  <td>{{ r.threshold }}{{ r.unit }}</td>
  <td>{% if r.is_anomaly %}<span class="badge badge-err">⚠️ 异常</span>
      {% elif r.value is none %}<span class="badge badge-gray">无数据</span>
      {% else %}<span class="badge badge-ok">✅ 正常</span>{% endif %}</td>
  <td style="color:var(--red);font-size:.8125rem">{{ r.error or "" }}</td>
</tr>
{% if r.is_anomaly and r.faq %}
<tr {% if r.is_anomaly %}style="background:var(--red-bg)"{% endif %}>
  <td colspan="5">
    <div class="faq"><div class="faq-title">💡 {{ r.name }} 处理建议</div>
    <pre style="white-space:pre-wrap;font-family:inherit">{{ r.faq }}</pre></div>
  </td>
</tr>
{% endif %}
{% endfor %}
</tbody>
</table>
{% endif %}

<!-- ES 日志 -->
<div class="section-title" style="margin-top:1.25rem">Elasticsearch 日志</div>
{% for r in s.es_results %}
<div class="es-block {% if r.ignorable %}ignorable{% endif %}">
  <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem;flex-wrap:wrap">
    <strong>{{ r.name }}</strong>
    {% if r.ignorable %}<span class="badge badge-gray">已知噪音</span>{% endif %}
    <span class="badge {% if r.total > 0 and not r.ignorable %}badge-warn{% else %}badge-ok{% endif %}">{{ r.total }} 条命中</span>
    <span style="color:var(--gray);font-size:.8125rem">· 索引 {{ r.index }}</span>
    {% if kibana_url and r.total > 0 %}
    <a href="{{ kibana_url }}/app/discover#/?_g=(time:(from:now-{{ r.time_range_hours }}h,to:now))&_a=(query:(language:lucene,query:'{{ r.query_string | urlencode }}'))" target="_blank" style="font-size:.8125rem;color:var(--blue);text-decoration:none">🔗 Kibana</a>
    {% endif %}
  </div>
  {% if r.error %}<div style="color:var(--red);font-size:.8125rem">{{ r.error }}</div>{% endif %}
  {% if r.hits and not r.ignorable %}
  <div class="log-list">{% for h in r.hits %}[{{ h.timestamp or "?" }}] {{ h.level or "-" }} | {{ h.message }}
{% endfor %}</div>
  {% endif %}
  {% if r.is_anomaly and r.faq %}
  <div class="faq"><div class="faq-title">💡 处理建议</div><pre style="white-space:pre-wrap;font-family:inherit">{{ r.faq }}</pre></div>
  {% endif %}
</div>
{% endfor %}

</div>{# end section #}
{% endfor %}

<!-- AI 分析 -->
<div class="section">
<div class="section-title">🤖 AI 综合分析</div>
<div class="ai-content">{{ ai_analysis }}</div>
</div>

<div style="text-align:center;color:var(--gray);font-size:.8125rem;margin-top:1rem">
由 Prometheus + ELK 巡检工具自动生成 &nbsp;·&nbsp; {{ generated_at }}
</div>
</div>
</body>
</html>
